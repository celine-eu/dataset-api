ENV=dev
LOG_LEVEL=INFO

# Public URIs — keep *.celine.localhost for local development; a deployment sets its own host.
API_BASE_URL=http://api.celine.localhost/datasets
CATALOG_URI=http://api.celine.localhost/datasets/catalog
DATASET_BASE_URI=http://api.celine.localhost/datasets/dataset
ENTITY_BASE_URI=http://api.celine.localhost/datasets/entity

# Catalogue database, and the warehouse the datasets are queried from.
DATABASE_URL=postgresql+psycopg://postgres:securepassword123@host.docker.internal:15432/datasets
DATASETS_DATABASE_URL=postgresql+psycopg://postgres:securepassword123@host.docker.internal:15432/datasets
# CATALOGUE_SCHEMA=dataset_api
# DB_POOL_RECYCLE_SECONDS=300
# The test suite never uses DATABASE_URL itself: it uses the same URL with "_test"
# appended to the database name (created on first run). To choose another, set:
# TEST_DATABASE_URL=postgresql+psycopg://postgres:securepassword123@host.docker.internal:15432/datasets_test

MARQUEZ_URL=http://marquez.celine.localhost
MARQUEZ_NAMESPACE=default
# OWNERS_YAML_PATH=./owners.yaml

# OIDC (celine-sdk OidcSettings). The client credentials are also what
# `dataset-cli import catalogue` authenticates with: POST /admin/catalogue needs the
# dataset.admin scope, which svc-dataset-api holds. DATASET_API_TOKEN overrides them.
CELINE_OIDC_BASE_URL=http://keycloak.celine.localhost/realms/celine
CELINE_OIDC_JWKS_URI=http://keycloak.celine.localhost/realms/celine/protocol/openid-connect/certs
CELINE_OIDC_CLIENT_ID=svc-dataset-api
CELINE_OIDC_CLIENT_SECRET=svc-dataset-api
CELINE_OIDC_AUDIENCE=svc-dataset-api
# DATASET_API_TOKEN=

# Policies (Rego, evaluated in-process)
# POLICIES_CHECK_ENABLED=true
# POLICIES_DIR=./policies
# POLICIES_DATA_DIR=
# POLICIES_PACKAGE=celine.dataset
# POLICIES_CACHE_ENABLED=true

# Query and row filters
# QUERY_STATEMENT_TIMEOUT_MS=5000
# ROW_FILTERS_MODULES=[]
# ROW_FILTERS_CACHE_TTL=300
# ROW_FILTERS_CACHE_MAXSIZE=10000
# REC_REGISTRY_URL=http://api.celine.localhost/rec-registry

# Dataspace (EDR) path — docs/governance-security.md
# EDR_ENABLED=true
# CONNECTOR_INTERNAL_URL=http://ds-connector:30001
# CONNECTOR_INTERNAL_URLS={"did:web:a.example.org":"http://connector-a:30001"}

# Ontology conformance check — docs/catalogue-management.md
# CONFORMANCE_ENABLED=false
# CONFORMANCE_SAMPLE_LIMIT=100
# CONFORMANCE_MAX_SAMPLE=1000

# DPS data plane ("EDC mode", prototype) — docs/dps-data-plane.md
# DPS_ENABLED=true
# DPS_DATAPLANE_ID=dataset-api
# DPS_SIGNALING_URL=http://dataset-api:8001
# DPS_PUBLIC_URL=http://dataset-api:8001
# DPS_TRANSFER_TYPES=["HttpData-PULL"]
# DPS_LABELS=[]
# DPS_CONTROL_PLANE_CLIENTS=["svc-example-connector"]
# DPS_TOKEN_SIGNING_KEY=  # PEM EC P-256 private key; required, the same on every worker
# DPS_TOKEN_KEY_ID=
